NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# TURN relay, via Metered's credential API. Optional: without it the app falls
# back to STUN only, which cannot traverse carrier-grade NAT, so cross-network
# peers will fail to connect. The endpoint returns a ready-made iceServers
# array; the app fetches it once per room. Replace the placeholder key.
NEXT_PUBLIC_METERED_API_URL=https://YOUR_SUBDOMAIN.metered.live/api/v1/turn/credentials?apiKey=YOUR_API_KEY
